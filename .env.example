# Local service ports
API_PORT=4100
CONTROL_CENTER_PORT=5173
DEMO_APP_PORT=5174
POSTGRES_PORT=55432

# Local Postgres from docker-compose.yml
POSTGRES_USER=off
POSTGRES_PASSWORD=off
POSTGRES_DB=open_feedback_factory
DATABASE_URL=postgres://off:off@localhost:55432/open_feedback_factory
DOCKER_DATABASE_URL=postgres://off:off@postgres:5432/open_feedback_factory

# Browser API base used by the demo app and control center.
# Leave blank to use same-origin requests through Vite or Tailscale path proxies.
VITE_API_BASE_URL=
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:4100
# Comma-separated extra hosts for local Vite dev. Tailscale .ts.net hosts are allowed by default.
VITE_ALLOWED_HOSTS=
PUBLIC_BASE_URL=http://localhost:4100
CONTROL_CENTER_URL=http://localhost:5173

# Private dogfood access gates. Set these before exposing a tunnel or shared network URL.
ADMIN_TOKEN=
# Optional comma-separated scoped admin tokens, for example:
# viewer:long-read-only-token,operator:long-work-token,admin:long-policy-token
# ADMIN_TOKEN remains the owner token when configured.
ADMIN_ROLE_TOKENS=
RUNNER_TOKEN=

# Internal dogfood safety defaults.
OFF_CONFIG_SCHEMA_VERSION=1
APPROVAL_MODE=manual
MERGE_MODE=implement_only
AUTO_MERGE_ENABLED=false
MAX_SAFE_DIFF_LINES=120
MAX_FEATURE_COST_USD=5
MAX_DAILY_COST_USD=25
MAX_MONTHLY_COST_USD=100
MAX_TOKENS_PER_RUN=250000
PROTECTED_PATHS=auth,billing,privacy,legal,encryption,secrets,infra,migrations,release
RATE_LIMIT_WINDOW_MS=60000
SDK_RATE_LIMIT_MAX=120
ADMIN_RATE_LIMIT_MAX=120
RUNNER_RATE_LIMIT_MAX=300
GITHUB_RATE_LIMIT_MAX=300
# Encrypts integration secrets saved through the control plane. Required before storing provider credentials.
SECRETS_VAULT_KEY=

# Work cadence: "immediate" queues eligible feedback now, "threshold" waits for
# similar requests, and "scheduled" lets feedback queue while automatic workers
# claim only during the configured UTC batch window.
WORK_CADENCE_MODE=immediate
WORK_CADENCE_THRESHOLD=2
WORK_CADENCE_INTERVAL=weekly
WORK_CADENCE_DAY_OF_WEEK=1
WORK_CADENCE_DAY_OF_MONTH=1
WORK_CADENCE_HOUR_UTC=9

# Semantic clustering: groups differently-worded requests for the same feature
# by canonical intent instead of brittle keyword matching. Only the generic
# fallback bucket calls the model — dedicated buckets (dark mode, crash, etc.)
# stay deterministic, free, and instant. The classifier is shown the intents
# that already exist and reuses a matching one instead of minting a near-
# duplicate. Only the SANITIZED message is sent, and blocked/secret-bearing or
# protected-area feedback never leaves the box. Any model error or timeout
# falls back to the deterministic key, so intake never breaks.
# "auto" (default) enables it when ANTHROPIC_API_KEY is set; "off" hard-disables.
# With no key set, clustering degrades cleanly to deterministic keywords.
SEMANTIC_CLUSTERING=auto
ANTHROPIC_API_KEY=
SEMANTIC_CLUSTER_MODEL=claude-sonnet-4-6
SEMANTIC_CLUSTER_TIMEOUT_MS=4000

# Runner mode: "disabled" queues work without implementation; "codex" attaches a real Codex worker.
# Host CLI workers can be installed with `pnpm worker:install:host`.
# Docker API-key workers use the compose `worker` service after a key is saved in the control center.
CODEX_RUNNER_MODE=disabled
CODEX_AUTH_MODE=cli
CODEX_CLI=codex
DOCKER_CODEX_CLI=codex
CODEX_CLI_VERSION=0.141.0
CODEX_MODEL=gpt-5.5
CODEX_EFFORT=extra-high
CODEX_MANAGE_GIT=false
CODEX_TIMEOUT_MS=300000
CODEX_SANDBOX_MODE=workspace-write
CODEX_APPROVAL_POLICY=never
CODEX_NETWORK_ACCESS=false
CODEX_NETWORK_ALLOWED_DOMAINS=
CODEX_NETWORK_DENIED_DOMAINS=
CODEX_NETWORK_ALLOW_LOCAL=false
CODEX_NETWORK_ALLOW_UPSTREAM_PROXY=false
# Optional Codex execpolicy rules for outside-sandbox command approvals.
# Separate command prefixes with semicolons; each prefix is split into argv tokens by spaces.
# Example: CODEX_COMMAND_ALLOW_PREFIXES=gh pr view;git status
CODEX_COMMAND_ALLOW_PREFIXES=
CODEX_COMMAND_PROMPT_PREFIXES=
CODEX_COMMAND_DENY_PREFIXES=
CODEX_INPUT_USD_PER_1M=
CODEX_CACHED_INPUT_USD_PER_1M=
CODEX_OUTPUT_USD_PER_1M=
CODEX_REASONING_OUTPUT_USD_PER_1M=
OPENAI_API_KEY=
CODEX_SECRETS_PATH=.off/secrets.env
RUNNER_WORKSPACE=.

# Worker loop. Docker uses WORKER_API_BASE_URL=http://api:4100; local pnpm dev can use localhost.
WORKER_API_BASE_URL=http://api:4100
WORKER_NAME=local-worker
WORKER_POLL_INTERVAL_MS=5000
WORKER_RUN_ONCE=false
WORKER_WORK_ITEM_ID=

# GitHub integration. V1 exposes the GitHub App path, with gh-backed internal dogfood mode.
GITHUB_MODE=disabled
GITHUB_OWNER=joewilsonai
GITHUB_REPO=open-feedback-factory
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=dev-webhook-secret
GITHUB_CREATE_PR=false
GITHUB_PR_BASE=main
