{
  "name": "open-feedback-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "db:migrate": "pnpm --filter @open-feedback-factory/db migrate",
    "demo:reset": "pnpm --filter @open-feedback-factory/db demo:reset",
    "demo:seed": "node scripts/demo-seed.mjs",
    "dev": "pnpm --parallel --filter @open-feedback-factory/api --filter @open-feedback-factory/worker --filter @open-feedback-factory/control-center --filter @open-feedback-factory/demo-app dev",
    "docker:up": "docker compose up --build",
    "doctor": "node scripts/doctor.mjs",
    "render:prd": "node scripts/render-prd-html.mjs",
    "tunnel:tailscale": "node scripts/tailscale-funnel.mjs",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.16"
  }
}
