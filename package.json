{
  "name": "open-feedback-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "config:migrate": "node scripts/config-migrate.mjs",
    "db:migrate": "pnpm --filter @open-feedback-factory/db migrate",
    "demo:reset": "pnpm --filter @open-feedback-factory/db demo:reset",
    "demo:seed": "node scripts/demo-seed.mjs",
    "dev": "pnpm --parallel --filter @open-feedback-factory/api --filter @open-feedback-factory/worker --filter @open-feedback-factory/control-center --filter @open-feedback-factory/demo-app dev",
    "docker:up": "docker compose up --build",
    "doctor": "node scripts/doctor.mjs",
    "landing:build": "pnpm --filter @open-feedback-factory/landing build",
    "landing:dev": "pnpm --filter @open-feedback-factory/landing dev",
    "railway:build:api": "pnpm --filter @open-feedback-factory/api typecheck",
    "railway:build:control-center": "pnpm --filter @open-feedback-factory/control-center build",
    "railway:build:demo-app": "pnpm --filter @open-feedback-factory/demo-app build",
    "railway:build:worker": "pnpm --filter @open-feedback-factory/worker typecheck",
    "railway:start:api": "pnpm --filter @open-feedback-factory/db migrate && pnpm --filter @open-feedback-factory/api start",
    "railway:start:control-center": "pnpm --filter @open-feedback-factory/control-center start",
    "railway:start:demo-app": "pnpm --filter @open-feedback-factory/demo-app start",
    "railway:start:worker": "pnpm --filter @open-feedback-factory/worker start",
    "render:prd": "node scripts/render-prd-html.mjs",
    "start": "node scripts/railway-start.mjs",
    "tunnel:tailscale": "node scripts/tailscale-funnel.mjs",
    "test": "pnpm -r --if-present test && pnpm test:scripts",
    "test:scripts": "node --test scripts/*.test.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "worker:install:host": "node scripts/worker-install.mjs install --mode host-cli",
    "worker:print:docker-api": "node scripts/worker-install.mjs print --mode docker-api-key",
    "worker:print:host": "node scripts/worker-install.mjs print --mode host-cli",
    "worker:status:host": "node scripts/worker-install.mjs status --mode host-cli",
    "worker:uninstall:host": "node scripts/worker-install.mjs uninstall --mode host-cli"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
}
